{
  "name": "memory-airlock",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "eval": "eve eval",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "node --env-file-if-exists=.env src/measure.ts",
    "agent:dev": "eve dev --no-ui",
    "test": "node --env-file-if-exists=.env --test tests/*.test.ts",
    "verify:live": "node --env-file-if-exists=.env src/verify-live.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.137",
    "eve": "^0.79.1",
    "falkordb": "^6.8.0",
    "lucide": "^1.58.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
