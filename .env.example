# Free local inference. No card, API key or paid service is needed.
MEMORY_STORE=local
PORT=4317
AIRLOCK_WORKSPACE=demo-shop
# For the competition, use FalkorDB as the central store.
# Start compose.yaml, or use your FalkorDB Cloud Free endpoint.
# FALKORDB_URL=redis://127.0.0.1:6379
# FALKORDB_TEST_URL=redis://127.0.0.1:6379
AIRLOCK_ENABLE_AI=false
AIRLOCK_AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
